#!/usr/bin/env bash
set -euo pipefail

mapfile -d '' files < <(git diff --cached --name-only -z -- '*.nix')
(( ${#files[@]} )) || exit 0

# Formatting a partially staged file would also stage its unstaged changes.
# Refuse that case so a commit never captures work the user did not select.
for file in "${files[@]}"; do
  if ! git diff --quiet -- "$file"; then
    echo "Refusing to format partially staged file: $file" >&2
    echo "Stage or stash its remaining changes, then commit again." >&2
    exit 1
  fi
done

nix fmt -- "${files[@]}"
git add -- "${files[@]}"
